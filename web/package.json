    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@line/bot-sdk": "^11.3.0",
    "@mcky/ui": "https://codeload.github.com/ktypez/mcky-ui/tar.gz/712d2d3054dc21bbcc09472d4ced32ac32d48212",
    "aws4fetch": "^1.0.20"
  }
