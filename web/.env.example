# --- public (inlined into the client bundle at build time) ---
# LINE LIFF id used by /liff and by the webhook's deep links
PUBLIC_LIFF_ID=2010606328-7UnH1Yre

# Canonical site URL — og: tags and share links
PUBLIC_SITE_URL=http://localhost:5173

# "Add friend" deep link shown in the web header
PUBLIC_LINE_FRIEND_URL=https://line.me/R/ti/p/%40484cgfku

# --- private: LINE (read by /api/webhook) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Server-side copy of the LIFF id for webhook flex menus
LIFF_ID=2010606328-7UnH1Yre

# --- private: Cloudflare R2 (read by /api/collage, /api/cleanup) ---
# From the R2 dashboard: Account > Storage > R2 > Manage R2 API Tokens
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public dev URL of the bucket (https://<bucket>.<accountid>.r2.dev) — this is
# what gets handed to LINE, so the bucket must be readable from the internet.
R2_PUBLIC_URL=

# Shared secret for /api/cleanup. Set Vercel's CRON_SECRET to the SAME value so
# the scheduled job (vercel.json) authenticates with this one secret.
CLEANUP_SECRET=